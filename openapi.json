  },
  "components": {
    "schemas": {
      "Basket": {
        "properties": {
          "items": {
            "items": { "$ref": "#/components/schemas/Line" },
            "type": "array",
            "maxItems": 16,
            "minItems": 1,
            "title": "Items"
          },
          "coupon": {
            "type": "string",
            "maxLength": 30,
            "title": "Coupon",
            "default": ""
          },
          "delivery": {
            "type": "string",
            "enum": ["standard", "express"],
            "title": "Delivery",
            "default": "standard"
          }
        },
        "type": "object",
        "required": ["items"],
        "title": "Basket"
      },
      "Checkout": {
        "properties": {
          "items": {
            "items": { "$ref": "#/components/schemas/Line" },
            "type": "array",
            "maxItems": 16,
            "minItems": 1,
            "title": "Items"
          },
          "coupon": {
            "type": "string",
            "maxLength": 30,
            "title": "Coupon",
            "default": ""
          },
          "delivery": {
            "type": "string",
            "enum": ["standard", "express"],
            "title": "Delivery",
            "default": "standard"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 120,
            "minLength": 5,
            "title": "Email"
          },
          "address": {
            "type": "string",
            "maxLength": 200,
            "minLength": 5,
            "title": "Address"
          },
          "payment": {
            "type": "string",
            "enum": ["approved", "declined"],
            "title": "Payment",
            "default": "approved"
          }
        },
        "type": "object",
        "required": ["items", "name", "email", "address"],
        "title": "Checkout"
      },
      "Favorites": {
        "properties": {
          "product_ids": {
            "items": { "type": "string" },
            "type": "array",
            "maxItems": 16,
            "title": "Product Ids"
          }
        },
        "type": "object",
        "required": ["product_ids"],
        "title": "Favorites"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": { "$ref": "#/components/schemas/ValidationError" },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Line": {
        "properties": {
          "product_id": {
            "type": "string",
            "maxLength": 16,
            "title": "Product Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": ["product_id", "quantity"],
        "title": "Line"
      },
      "Review": {
        "properties": {
          "rating": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Rating"
          },
          "text": {
            "type": "string",
            "maxLength": 500,
            "minLength": 10,
            "title": "Text"
          }
        },
        "type": "object",
        "required": ["rating", "text"],
        "title": "Review"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
            "type": "array",
            "title": "Location"
          },
          "msg": { "type": "string", "title": "Message" },
          "type": { "type": "string", "title": "Error Type" }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
